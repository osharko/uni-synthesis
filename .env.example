# === uni-synthesis — configurazione (copia in .env e personalizza) ===
#
# Tutti i path possono essere assoluti o relativi a questa directory.
# Le variabili qui sotto sono usate principalmente da scripts/ocr_to_text.py;
# full_to_text.py e gli altri script accettano gli stessi parametri da CLI.

# --- I/O ---
# PDF da processare (può essere sovrascritto da CLI)
INPUT_PDF=./books/MioLibro.pdf
# Cartella di lavoro per il libro (default: books/<basename del PDF>)
WORK_DIR=

# --- Split doppia pagina (solo OCR / scansioni) ---
AUTO_SPLIT=true
AUTO_SPLIT_RANGE=0.15
SPLIT_POSITION=0.50
CENTER_CROP_MARGIN=0.02
OUTER_CROP_MARGIN=0.01
VERTICAL_CROP_MARGIN=0.01

# --- Range pagine (1-indexed, vuoto = tutte) ---
PAGE_START=
PAGE_END=

# --- Render / qualità ---
RENDER_DPI=300
JPEG_QUALITY=85

# --- Image enhancement ---
ENHANCE_CONTRAST=true
CONTRAST_FACTOR=1.3
SHARPEN=true
SHARPNESS_FACTOR=1.5
ADJUST_BRIGHTNESS=true
BRIGHTNESS_FACTOR=1.05
GRAYSCALE=true

# --- OCR (ocrmypdf + tesseract) ---
OCR_ENABLED=true
OCR_LANGUAGE=ita
OCR_DPI=300
OCR_SKIP_TEXT=true
OCR_DESKEW=true

# --- Quality check ---
# Ratio sintesi target: 1/RATIO_MIN .. 1/RATIO_MAX (default: 5..8)
QC_RATIO_MIN=5
QC_RATIO_MAX=8
# Soglia minima di copertura entità/citazioni (0-1) per superare il quality check
QC_COVERAGE_THRESHOLD=0.75

# --- LLM opzionale (cloud, solo se quality_check.py --llm) ---
# Il repo è AGNOSTICO rispetto al modello: puoi usare qualsiasi provider/modello.
# (esempio: un modello cloud per il giudizio semantico del quality check)
ANTHROPIC_API_KEY=
LLM_MODEL=

# --- LLM LOCALE opzionale (endpoint OpenAI-compatibile) ---
# Utile per far fare a un modello locale la comprensione/pulizia del testo.
# Nessun provider/modello è imposto: punta a QUALSIASI server OpenAI-compatibile
# (llama.cpp, Ollama, vLLM, LM Studio, text-generation-webui, Unsloth, ...).
# Tutte OPZIONALI: gli script core (split / OCR / cross-check) non le usano.
LOCAL_LLM_BASE_URL=        # es. http://127.0.0.1:8080/v1
LOCAL_LLM_API_KEY=         # valorizza solo se il server la richiede
LOCAL_LLM_MODEL=           # nome/id del modello servito dal tuo server

# --- Export PDF (opzionale, usato da export_pdf.py) ---
# Engine preferito: xelatex | lualatex | tectonic | typst | weasyprint
# (auto-detect se vuoto: prova prima LaTeX, poi typst, poi weasyprint)
PDF_ENGINE=
