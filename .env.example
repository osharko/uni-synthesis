# === uni-synthesis — configurazione (copia in .env e personalizza) ===
#
# Tutti i path possono essere assoluti o relativi a questa directory.
# Le variabili qui sotto sono usate principalmente da scripts/ocr_to_text.py;
# full_to_text.py e gli altri script accettano gli stessi parametri da CLI.

# --- I/O ---
# PDF da processare (può essere sovrascritto da CLI)
INPUT_PDF=./books/MioLibro.pdf
# Cartella di lavoro per il libro (default: books/<basename del PDF>)
WORK_DIR=

# --- Split doppia pagina (solo OCR / scansioni) ---
AUTO_SPLIT=true
AUTO_SPLIT_RANGE=0.15
SPLIT_POSITION=0.50
CENTER_CROP_MARGIN=0.02
OUTER_CROP_MARGIN=0.01
VERTICAL_CROP_MARGIN=0.01

# --- Range pagine (1-indexed, vuoto = tutte) ---
PAGE_START=
PAGE_END=

# --- Render / qualità ---
RENDER_DPI=300
JPEG_QUALITY=85

# --- Image enhancement ---
ENHANCE_CONTRAST=true
CONTRAST_FACTOR=1.3
SHARPEN=true
SHARPNESS_FACTOR=1.5
ADJUST_BRIGHTNESS=true
BRIGHTNESS_FACTOR=1.05
GRAYSCALE=true

# --- OCR (ocrmypdf + tesseract) ---
OCR_ENABLED=true
OCR_LANGUAGE=ita
OCR_DPI=300
OCR_SKIP_TEXT=true
OCR_DESKEW=true

# --- Quality check ---
# Ratio sintesi target: 1/RATIO_MIN .. 1/RATIO_MAX (default: 5..8)
QC_RATIO_MIN=5
QC_RATIO_MAX=8
# Soglia minima di copertura entità/citazioni (0-1) per superare il quality check
QC_COVERAGE_THRESHOLD=0.75

# --- LLM opzionale (quality_check.py --llm) — endpoint OpenAI-compatibile ---
# Il repo è AGNOSTICO rispetto al modello: punta a QUALSIASI server
# OpenAI-compatibile, locale o cloud (llama.cpp, Ollama, vLLM, LM Studio,
# text-generation-webui, Unsloth, ...). Se LLM_BASE_URL/LLM_MODEL sono vuoti,
# il giudizio LLM viene saltato (le metriche deterministiche funzionano comunque).
LLM_BASE_URL=              # es. http://127.0.0.1:8080/v1
LLM_API_KEY=               # valorizza solo se il server la richiede
LLM_MODEL=                 # nome/id del modello servito
# Parametri extra (JSON) aggiunti al payload, es. per disattivare il "thinking":
LLM_EXTRA_PARAMS=          # es. {"enable_thinking": false}
# Timeout (secondi) e massimo di token della risposta per il giudizio LLM:
LLM_TIMEOUT=600
LLM_MAX_TOKENS=1200

# (alias di comodità, opzionali: usati se LLM_* è vuoto)
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=

# --- Export PDF (opzionale, usato da export_pdf.py) ---
# Engine preferito: xelatex | lualatex | tectonic | typst | weasyprint
# (auto-detect se vuoto: prova prima LaTeX, poi typst, poi weasyprint)
PDF_ENGINE=
